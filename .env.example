# =============================================================================
# Sports Stats Platform — Environment Template
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
# `.env.local` is git-ignored and must NEVER be committed.
# In CI/CD and production, set these as GitHub Actions secrets / host env vars.
# These are NAMES ONLY — no real secret values live in this file.
# =============================================================================

# --- Core generated secrets (regenerate for production) ----------------------
# Generate with: openssl rand -base64 48   (or -hex 32 for the key)
JWT_SECRET=
NEXTAUTH_SECRET=
ENCRYPTION_KEY=                 # 32-byte hex; encrypts provider keys at rest
INTERNAL_API_SECRET=           # service-to-service auth
CRON_SECRET=                   # protects /api/cron/* ingestion endpoints
WEBHOOK_SECRET=                # verifies inbound provider webhooks

# --- Datastores (Phase 1: Postgres + Redis only) ----------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/sportsdb
DATABASE_URL_SHADOW=postgresql://postgres:password@localhost:5432/sportsdb_shadow
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# --- Phase 2+ datastores (leave blank until provisioned) --------------------
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
ELASTICSEARCH_URL=
KAFKA_BROKERS=
KAFKA_SECRET=

# --- Phase 1 sports data providers (self-serve; sign up then fill) ----------
API_FOOTBALL_KEY=
SPORTMONKS_TOKEN=
THE_ODDS_API_KEY=
FOOTBALL_DATA_ORG_KEY=
STATSBOMB_USER=
STATSBOMB_PASS=

# --- Phase 2/3 providers (enterprise / B2B — leave blank for now) ------------
SPORTRADAR_API_KEY=
GENIUS_SPORTS_CLIENT_ID=
GENIUS_SPORTS_CLIENT_SECRET=
GENIUS_SPORTS_AUTH_URL=https://auth.geniussports.com
STATS_PERFORM_API_KEY=
STATS_PERFORM_SECRET=

# --- Scraper fleet (Phase 2; corroboration only) ----------------------------
SCRAPER_PROXY_SALT=

# --- App config --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development
